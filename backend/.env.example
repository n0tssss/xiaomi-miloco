# miloco backend .env 模板(给 pr-hermes fork 用)

# 【hermes-pr.md §五 #1+#2+#4+#11 完整迁移后】adapter 通过 importlib 加载
# plugin/hermes_adapter/,prompt 注入走 <system> 消息,IM 投递走 hermes send CLI。
# 下面这些变量是 backend 自己用的(perception/rule/task/omni LLM)。

# ====== Omni LLM(感知/规则/任务 agent 用的模型)======
# 默认 MiMo(minimax-cn + mimo-v2.5),按需改
MILOCO_OMNI_API_KEY=
MILOCO_OMNI_BASE_URL=https://api.xiaomimimo.com/v1
MILOCO_OMNI_MODEL=xiaomi/mimo-v2.5

# ====== Xiaomi 账号 OAuth(米家设备控制)======
# miloco-cli account bind 后自动写,不需要手填
# 保留位:真用时跑 `miloco-cli account bind` 走 OAuth 流程

# ====== Agent 平台 adapter(主线 #1+#2)======
# 必填:platform=hermes 触发 adapter 加载
# 由 install-hermes.sh Step 4.8 自动写,不需要手填
# MILOCO_AGENT__PLATFORM=hermes

# ====== Hermes gateway URL(adapter 直调用)======
# 默认 http://127.0.0.1:8642(hermes gateway 主端口)
# 改 hermes 部署位置时调
# MILOCO_AGENT__HERMES_URL=http://127.0.0.1:8642

# ====== 后端服务 ====

# 不要改,影响 supervisor 行为
# MILOCO_SUPERVISED=1

# 日志级别:debug/info/warning/error(默认 info)
# MILOCO_LOG_LEVEL=info
